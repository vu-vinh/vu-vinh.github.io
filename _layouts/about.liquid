---
layout: default
# This file is "custom" (not the original file). This makes the social icons show under profile picture and adjust the interface of icons
---
<style>
  .profile .contact-icons {
    display: grid;
    grid-template-columns: repeat(3, 50px);
    gap: 12px;
    margin-top: 16px;
  }
  .profile .contact-icons a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    border-radius: 11px;
    background: #fff;
    border: 1px solid #0076df;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
    transition: all 0.15s ease;
  }
  .profile .contact-icons a i {
    font-size: 1.8rem;
    color: #0076df !important;
  }
  .profile .contact-icons a i::before {
    color: #0076df !important;
  }
  .profile .contact-icons a svg {
    width: 26px;
    height: 26px;
    fill: #0076df !important;
    color: #0076df !important;
  }
  .profile .contact-icons a svg * {
    fill: #0076df !important;
    stroke: #0076df !important;
  }
  .profile .contact-icons a img {
    width: 24px;
    height: 24px;
    object-fit: contain;
    filter: invert(29%) sepia(89%) saturate(3200%) hue-rotate(199deg) brightness(97%) contrast(101%);
  }
  .profile .contact-icons a[href*='orcid.org'] {
    background: #fff !important;
    border: 1px solid #0076df !important;
  }
  .profile .contact-icons a[href*='orcid.org'] svg,
  .profile .contact-icons a[href*='orcid.org'] img {
    filter: invert(29%) sepia(89%) saturate(3200%) hue-rotate(199deg) brightness(97%) contrast(101%) !important;
  }
  .profile .contact-icons a:hover {
    background: #eaf4ff;
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
  }
  .profile .cv-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 174px;
    max-width: 100%;
    min-height: 58px;
    gap: 10px;
    margin-top: 14px;
    padding: 12px;
    border: 1px solid #28679a;
    border-radius: 10px;
    color: #fff;
    background: #28679a;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
    transition:
      transform 0.15s,
      background 0.15s,
      box-shadow 0.15s;
  }
  .profile .cv-link:hover {
    color: #fff;
    background: #215a88;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.14);
    text-decoration: none;
    transform: translateY(-1px);
  }
  .profile .cv-link svg {
    width: 25px;
    height: 25px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>
  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
        <!-- Social (moved here so it shows under the profile picture) -->
        {% if page.social %}
          <div class="social">
            <div class="contact-icons">{% social_links %}</div>
            <a class="cv-link" href="{{ site.cv_pdf | relative_url }}" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14 3H6v18h12V7l-4-4Z"></path>
                <path d="M14 3v4h4"></path>
              </svg>
              <span>Download CV</span>
            </a>
            <div class="contact-note">{{ site.contact_note }}</div>
          </div>
        {% endif %}
      </div>
    {% endif %}
    <div class="clearfix">{{ content }}</div>
    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}
    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      <div class="news">
        {% if page.latest_posts != blank %}
          {% assign latest_posts_size = site.posts | where_exp: 'item', 'item.hidden != true' | size %}
          <div
            class="table-responsive"
            {% if page.latest_posts.scrollable and latest_posts_size > 3 %}
              style="max-height: 60vw"
            {% endif %}
          >
            <table class="table table-sm table-borderless">
              {% assign latest_posts = site.posts | where_exp: 'item', 'item.hidden != true' %}
              {% if page.latest_posts.limit %}
                {% assign latest_posts_limit = page.latest_posts.limit %}
              {% else %}
                {% assign latest_posts_limit = latest_posts_size %}
              {% endif %}
              {% for item in latest_posts limit: latest_posts_limit %}
                <tr>
                  <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
                  <td>
                    {% if item.redirect == blank %}
                      <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                    {% elsif item.redirect contains '://' %}
                      <a class="news-title" href="{{ item.redirect }}" target="_blank">{{ item.title }}</a>
                      <svg width="2rem" height="2rem" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                        <path
                          d="M17 13.5v6H5v-12h6m3-3h6v6m0-6-9 9"
                          class="icon_svg-stroke"
                          stroke="#999"
                          stroke-width="1.5"
                          fill="none"
                          fill-rule="evenodd"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        ></path>
                      </svg>
                    {% else %}
                      <a class="news-title" href="{{ item.redirect | relative_url }}">{{ item.title }}</a>
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            </table>
          </div>
        {% else %}
          <p>No posts so far...</p>
        {% endif %}
      </div>
    {% endif %}
    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}
    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center_margin.liquid %}
      {% else %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    {% endif %}
  </article>
</div>
